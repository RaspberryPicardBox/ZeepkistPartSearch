<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ZeepkistPartSearch.Plugin — a search bar at the top of the level editor's parts
    selector, which can look through every folder of the palette at once.

    TargetFramework (net472), the BepInEx/Unity/Zeepkist reference HintPaths and the
    game-path properties all live in the repository-root Directory.Build.props.

    The output DLL name is fixed to ZeepkistPartSearch.dll so that tools/deploy-plugin.sh
    and the mod.io package layout find it at:
      plugin/ZeepkistPartSearch.Plugin/bin/<Configuration>/net472/ZeepkistPartSearch.dll
  -->

  <PropertyGroup>
    <AssemblyName>ZeepkistPartSearch</AssemblyName>
    <RootNamespace>ZeepkistPartSearch</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>ZeepkistPartSearch</Product>
    <Description>Adds a search bar to the level editor parts selector and searches every folder.</Description>
    <Copyright>MIT</Copyright>
    <!-- Keep the output to our own DLL: BepInEx, Unity and game assemblies come from the install. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(GameDir)' == ''">
    <Error Text="GameDir is not set. Point the build at your Zeepkist install: dotnet build -p:GameDir=/path/to/Zeepkist, or set ZEEPKIST_GAME_DIR, or create local.props (see local.props.example)." />
  </Target>

  <ItemGroup>
    <!-- Reference assemblies so net472 compiles on Linux with the .NET SDK. Build-only. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
